import numpy as np

datos = np.array([
    [36.5,  72,  95],
    [38.2, 104, 140],
    [37.0,  80,  88],
    [36.8,  65, 110],
    [39.1, 112, 125]
])

minimos = np.min(datos, axis=0)
maximos = np.max(datos, axis=0)

datos_normalizados = (datos - minimos) / (maximos - minimos)

print("Datos normalizados:")
print(datos_normalizados)


min_verificacion = np.min(datos_normalizados, axis=0)
max_verificacion = np.max(datos_normalizados, axis=0)

print(f"\nMínimos por columna: {min_verificacion}")
print(f"Máximos por columna: {max_verificacion}")